# Salin file ini menjadi .env lalu isi nilainya.

# ===== Dashboard =====
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
TIMEZONE=Asia/Jakarta
# URL publik aplikasi setelah di-deploy (tanpa / di akhir). Meta mengambil gambar dari sini.
PUBLIC_BASE_URL=https://nama-app-anda.up.railway.app
# Folder data (database + gambar). Di Railway, arahkan ke volume, mis. /data
# DATA_DIR=/data

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high (makin tinggi makin bagus & mahal)
OPENAI_IMAGE_QUALITY=medium

# ===== Brand =====
BRAND_HANDLE=@familyreadybinder
# Pilar dipisah tanda |
PILLARS=Caring for Aging Parents|Be Ready (legacy & emergency documents)|Retirement & Next Chapter|Family Stories & Nostalgia
# (opsional) BRAND_AUDIENCE dan BRAND_STYLE bisa diganti juga

# ===== Jadwal =====
# Jam posting (zona TIMEZONE). 19:30 WIB = 08:30 pagi New York, 07:30 WIB = 20:30 malam New York (saat EDT)
POST_TIMES=19:30,07:30
# Buat draf otomatis tiap hari (masuk antrean review, TIDAK langsung diposting)
AUTO_GENERATE_DAILY=true
AUTO_GENERATE_TIME=09:00
AUTO_GENERATE_COUNT=2

# ===== Meta: Facebook Page + Instagram =====
META_APP_ID=
META_APP_SECRET=
GRAPH_VERSION=v23.0
# Tiga nilai di bawah bisa dikosongkan jika menghubungkan lewat halaman Pengaturan
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=

# ===== Threads =====
THREADS_APP_ID=
THREADS_APP_SECRET=
# Bisa dikosongkan jika menghubungkan lewat halaman Pengaturan
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ===== Mode uji coba =====
# FAKE_AI=true  -> tidak memanggil OpenAI (gambar contoh, gratis)
# DRY_RUN=true  -> tidak benar-benar memposting
FAKE_AI=false
DRY_RUN=false
