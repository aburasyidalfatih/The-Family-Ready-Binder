# Salin file ini menjadi .env lalu isi nilainya.

# ===== Dashboard =====
DASHBOARD_USER=admin
# WAJIB diganti (min. 8 karakter); aplikasi menolak start dengan password bawaan
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
TIMEZONE=Asia/Jakarta
# URL publik aplikasi setelah di-deploy (tanpa / di akhir). Meta mengambil gambar dari sini.
PUBLIC_BASE_URL=https://nama-app-anda.up.railway.app
# Folder data (database + gambar). Di Railway, arahkan ke volume, mis. /data
# DATA_DIR=/data

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high (makin tinggi makin bagus & mahal)
OPENAI_IMAGE_QUALITY=medium

# ===== Brand =====
BRAND_HANDLE=@familyreadybinder
# Pilar dipisah tanda |
PILLARS=Caring for Aging Parents|Be Ready (legacy & emergency documents)|Retirement & Next Chapter|Family Stories & Nostalgia
# (opsional) BRAND_AUDIENCE dan BRAND_STYLE bisa diganti juga

# ===== Jadwal =====
# TIMEZONE (di atas) = zona waktu tampilan dashboard & draf otomatis (zona Anda).
# POST_TIMEZONE + POST_TIMES = jam posting menurut zona audiens. Dengan America/New_York,
# jadwal otomatis mengikuti pergantian jam musim panas/dingin (DST) di AS.
POST_TIMEZONE=America/New_York
POST_TIMES=08:30,20:30
# Buat draf otomatis tiap hari (masuk antrean review, TIDAK langsung diposting)
AUTO_GENERATE_DAILY=true
AUTO_GENERATE_TIME=09:00
AUTO_GENERATE_COUNT=2
# Post yang terlewat lebih dari sekian jam (mis. server mati) tidak diposting otomatis (0 = tanpa batas)
MAX_LATE_HOURS=6
# Gambar milik post yang ditolak dihapus setelah sekian hari
MEDIA_RETENTION_DAYS=30

# ===== Produk (CTA halus) =====
# Kosongkan PRODUCT_NAME bila belum ingin menyebut produk sama sekali
PRODUCT_NAME=The Family Ready Binder
PRODUCT_DESCRIPTION=a printable binder to organize your family's important documents and wishes
PRODUCT_URL=
# 1 dari sekian post menyebut produk secara halus (sisanya murni konten bermanfaat)
CTA_EVERY=5

# ===== Meta: Facebook Page + Instagram =====
META_APP_ID=
META_APP_SECRET=
GRAPH_VERSION=v23.0
# Tiga nilai di bawah bisa dikosongkan jika menghubungkan lewat halaman Pengaturan
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=

# ===== Threads =====
THREADS_APP_ID=
THREADS_APP_SECRET=
# Bisa dikosongkan jika menghubungkan lewat halaman Pengaturan
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ===== Mode uji coba =====
# FAKE_AI=true  -> tidak memanggil OpenAI (gambar contoh, gratis)
# DRY_RUN=true  -> tidak benar-benar memposting
FAKE_AI=false
DRY_RUN=false
